            , <&macro_press &midi NOTE_C_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_D>
            , <&macro_release &midi NOTE_D_5>
            , <&macro_release &midi NOTE_Fs_5>
            , <&macro_release &midi NOTE_A_5>
            , <&macro_release &midi NOTE_C_6>
            ;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_A_sev: A_seventh {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_A>
            , <&macro_press &midi NOTE_A_5>
            , <&macro_press &midi NOTE_Cs_6>
            , <&macro_press &midi NOTE_E_6>
            , <&macro_press &midi NOTE_G_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_A>
            , <&macro_release &midi NOTE_A_5>
            , <&macro_release &midi NOTE_Cs_6>
            , <&macro_release &midi NOTE_E_6>
            , <&macro_release &midi NOTE_G_6>
            ;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_E_sev: E_seventh {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_E>
            , <&macro_press &midi NOTE_E_5>
            , <&macro_press &midi NOTE_Gs_5>
            , <&macro_press &midi NOTE_B_5>
            , <&macro_press &midi NOTE_D_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_E>
            , <&macro_release &midi NOTE_E_5>
            , <&macro_release &midi NOTE_Gs_5>
            , <&macro_release &midi NOTE_B_5>
            , <&macro_release &midi NOTE_D_6>
            ;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_B_sev: B_seventh {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_B>
            , <&macro_press &midi NOTE_B_5>
            , <&macro_press &midi NOTE_Ds_6>
            , <&macro_press &midi NOTE_Fs_6>
            , <&macro_press &midi NOTE_A_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_B>
            , <&macro_release &midi NOTE_B_5>
            , <&macro_release &midi NOTE_Ds_6>
            , <&macro_release &midi NOTE_Fs_6>
            , <&macro_release &midi NOTE_A_6>
            ;
        };


// we want to be able to toggle on/off chords playing when chord keys are pressed
// can we set a global variable to do this?
// 

/**
 * Temporarily switches to a layer (`&mo`) while a modifier is held.
 * Analogous to QMK's `LM()`, using a parameterized macro.
 *
 * Params:
 *  1. Layer to switch to
 *  2. Modifier to press while layer is active
 *
 * Example:
 *  `&lm NUM_LAYER LSHIFT`
 */
lm: lm {
    compatible = "zmk,behavior-macro-two-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <2>;
    bindings
        = <&macro_param_1to1>
        , <&macro_press &mo MACRO_PLACEHOLDER>
        , <&macro_param_2to1>
        , <&macro_press &kp MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_param_2to1>
        , <&macro_release &kp MACRO_PLACEHOLDER>
        , <&macro_param_1to1>
        , <&macro_release &mo MACRO_PLACEHOLDER>
        ;
};
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |    Q    |    W    |    E    |    R    |    T    |                                          |    Y    |    U    |    I    |    O    |    P    |
// |    A    |    S    |    D    |    F    |    G    |                                          |    H    |    J    |    K    |    L    |    ;    |
// |    Z    |    X    |    C    |    V    |    B    |                                          |    N    |    M    |    ,    |    .    |    /    |
// |BT/USB td|  VOL_DN | VOL_UP  |                                                                                  |   LALT  |   DEL   |   bt sho  |
//                               |   GUI   |   SPACE | ESC     |                      |backspace| L SHIFT |  ENTER  |
//                                         |NUM_LAYER| l_ctrl  |                      |   TAB   |ARROW_LAYER|

bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
    &out_td &kp C_VOL_DN &kp C_VOL_UP                                                                                   &kp LALT  &kp DEL   &bt BT_SHO
                                  &kp LGUI    &kp SPC   &kp ESC                         &kp BSPC  &kp LSHFT  &kp ENTER
                                              &mo NUM_L &kp LCTRL                       &kp TAB   &mo ARROW_L
            >;
        };

        num_layer {
bindings = <
  &bt BT_SEL 0   &kp GRAVE &kp MINUS &kp EQUAL   &none                                               &none     &kp N7    &kp N8    &kp N9     &none
  &bt BT_SEL 1   &kp LBKT  &kp RBKT   &kp BSLH   &none                                               &kp N0    &kp N4    &kp N5    &kp N6     &none
  &bt BT_SEL 2   &kp SEMI   &kp SQT   &kp FSLH   &none                                               &kp DOT   &kp N1    &kp N2    &kp N3    &none
  &bt BT_SEL 3    &trans    &trans                                                                                      &trans   &trans    &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        arrow_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &to MIDI_BASE                                                 &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
   &bt BT_CLR    &none &none    &none   &none                                                &kp HOME    &none       &none     &kp END    &to GAME_L
      &trans    &trans  &trans                                                                                        &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        game_layer {
bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
      &kp N0     &kp N1   &kp N2                                                                                       &kp N3  &kp N4      &kp N5
                                  &kp LSHFT    &kp SPC   &kp ESC                      &kp BSPC  &kp LSHFT  &kp RALT
                                              &mo LCTRL &kp TAB                       &kp TAB   &mo GAME_FN_L
            >;
        };

        game_function_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &none                                                &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
      &none     &none   &none   &none   &none                                                &none       &none       &none     &none  &to DEFAULT_L
      &trans    &trans  &trans                                                                                       &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };


        midi_base {
bindings = <
   &mo MA_Ab  &mo MA_Eb  &mo MA_Bb &mo MA_F &mo MA_C                             &none     &none   &none  &none     &none
   &mo MI_Ab  &mo MI_Eb  &mo MI_Bb &mo MI_F &mo MI_C                             &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                  &none  &mo MIDI_BASE_2 &tog MIDI_BASE_2     &midi OCT_UP  &none &none
                                         &mo CHORD  &tog  CHORD               &midi OCT_DOWN  &midi SUSTAIN
            >;
        };

        midi_base_2 {
bindings = <
   &mo MA_G  &mo MA_D  &mo MA_A &mo MA_E &mo MA_B                              &none     &none   &none  &none     &none
   &mo MI_G  &mo MI_D  &mo MI_A &mo MI_E &mo MI_B                                &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                  &none  &mo MIDI_BASE &tog MIDI_BASE     &midi OCT_UP  &none &none
                                         &mo CHORD  &tog  CHORD               &midi OCT_DOWN  &midi SUSTAIN
            >;
        };


// ############################################
// **** PLACE SCALE LAYERS BELOW HERE *********
// ############################################
        Ab_major {
bindings = <
   &mo MA_Ab  &mo MA_Eb  &mo MA_Bb &mo MA_F &mo MA_C                           &midi NOTE_G_5   &midi NOTE_Bb_5   &midi NOTE_Db_6  &midi NOTE_F_6     &midi NOTE_Ab_6
   &mo MI_Ab  &mo MI_Eb  &mo MI_Bb &mo MI_F &mo MI_C                           &midi NOTE_F_5   &midi NOTE_Ab_5   &midi NOTE_C_6  &midi NOTE_Eb_6     &midi NOTE_G_6
