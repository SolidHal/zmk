            , <&macro_press &midi NOTE_D_6>
            , <&macro_press &midi NOTE_F_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_Bb>
            , <&macro_release &midi NOTE_Bb_5>
            , <&macro_release &midi NOTE_D_6>
            , <&macro_release &midi NOTE_F_6>
            ;
        };


