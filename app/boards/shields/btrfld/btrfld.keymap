#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/midi.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>



// go to bootloader: &bootloader
// presents key from higher layer: &trans
// no function: &none

#define DEFAULT_L  0
#define NUM_L      1
#define ARROW_L    2
#define GAME_L     3
#define GAME_FN_L  4

#define MIDI_BASE   5
#define MIDI_BASE_2 6

// Major chords
#define MA_Ab  7
#define MA_Eb  8
#define MA_Bb  9
#define MA_F  10
#define MA_C  11
#define MA_G  12
#define MA_D  13
#define MA_A  14
#define MA_E  15
#define MA_B  16

// Minor Chords
#define MI_Ab  17
#define MI_Eb  18
#define MI_Bb  19
#define MI_F  20
#define MI_C  21
#define MI_G  22
#define MI_D  23
#define MI_A  24
#define MI_E  25
#define MI_B  26

// 7ths 
#define SEV_Ab  27
#define SEV_Eb  28
#define SEV_Bb  29
#define SEV_F  30
#define SEV_C  31
#define SEV_G  32
#define SEV_D  33
#define SEV_A  34
#define SEV_E  35
#define SEV_B  36

// Major 7ths
#define MA7_Ab  37
#define MA7_Eb  38
#define MA7_Bb  39
#define MA7_F  40
#define MA7_C  41
#define MA7_G  42
#define MA7_D  43
