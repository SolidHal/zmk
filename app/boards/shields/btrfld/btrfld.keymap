        B_major {
bindings = <
   &midi NOTE_Ds_5   &midi NOTE_Fs_5   &midi NOTE_As_5  &midi NOTE_Cs_6   &midi NOTE_E_6                   &midi NOTE_Gs_6   &midi NOTE_B_6  &midi NOTE_Ds_7  &midi NOTE_Fs_7  &midi NOTE_As_7
   &midi NOTE_Cs_5   &midi NOTE_E_5   &midi NOTE_Gs_5  &midi NOTE_B_5   &midi NOTE_Ds_6                   &midi NOTE_Fs_6   &midi NOTE_As_6 &midi NOTE_Cs_7  &midi NOTE_E_7  &midi NOTE_Gs_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_E                                                                         &to MI_Gb  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_B  &none                        &midi OCT_UP  &none  &midi SUSTAIN
