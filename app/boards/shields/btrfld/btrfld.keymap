   &midi NOTE_Ab_4   &midi NOTE_B_4   &midi NOTE_Eb_5  &midi NOTE_Gb_5   &midi NOTE_Bb_5                   &midi NOTE_Db_6   &midi NOTE_F_6 &midi NOTE_Ab_6  &midi NOTE_B_6  &midi NOTE_Eb_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_B                                                                         &to MI_Db  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_Gb  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_Gb MA_Gb  &none      &midi OCT_DOWN  &none
