        Db_major {
bindings = <
   &midi NOTE_F_4   &midi NOTE_Ab_4   &midi NOTE_C_5  &midi NOTE_Eb_5   &midi NOTE_Gb_5                   &midi NOTE_Bb_5   &midi NOTE_Db_6  &midi NOTE_F_6  &midi NOTE_Ab_6  &midi NOTE_C_7
   &midi NOTE_Eb_4   &midi NOTE_Gb_4   &midi NOTE_Bb_4  &midi NOTE_Db_5   &midi NOTE_F_5                   &midi NOTE_Ab_5   &midi NOTE_C_6 &midi NOTE_Eb_6  &midi NOTE_Gb_6  &midi NOTE_Bb_6
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_Gb                                                                         &to MI_Ab  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_Db  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_Db MA_Db  &none      &midi OCT_DOWN  &none
            >;
        };


        Ab_major {
bindings = <
   &midi NOTE_C_5   &midi NOTE_Eb_5   &midi NOTE_G_5  &midi NOTE_Bb_5   &midi NOTE_Db_6                   &midi NOTE_F_6   &midi NOTE_Ab_6  &midi NOTE_C_7  &midi NOTE_Eb_7  &midi NOTE_G_7
   &midi NOTE_Bb_4   &midi NOTE_Db_5   &midi NOTE_F_5  &midi NOTE_Ab_5   &midi NOTE_C_6                   &midi NOTE_Eb_6   &midi NOTE_G_6 &midi NOTE_Bb_6  &midi NOTE_Db_7  &midi NOTE_F_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_Db                                                                         &to MI_Eb  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_Ab  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_Ab MA_Ab  &none      &midi OCT_DOWN  &none
            >;
        };


        Eb_major {
bindings = <
   &midi NOTE_G_4   &midi NOTE_Bb_4   &midi NOTE_D_5  &midi NOTE_F_5   &midi NOTE_Ab_5                   &midi NOTE_C_6   &midi NOTE_Eb_6  &midi NOTE_G_6  &midi NOTE_Bb_6  &midi NOTE_D_7
   &midi NOTE_F_4   &midi NOTE_Ab_4   &midi NOTE_C_5  &midi NOTE_Eb_5   &midi NOTE_G_5                   &midi NOTE_Bb_5   &midi NOTE_D_6 &midi NOTE_F_6  &midi NOTE_Ab_6  &midi NOTE_C_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_Ab                                                                         &to MI_Bb  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_Eb  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_Eb MA_Eb  &none      &midi OCT_DOWN  &none
            >;
        };


        Bb_major {
bindings = <
   &midi NOTE_D_5   &midi NOTE_F_5   &midi NOTE_A_5  &midi NOTE_C_6   &midi NOTE_Eb_6                   &midi NOTE_G_6   &midi NOTE_Bb_6  &midi NOTE_D_7  &midi NOTE_F_7  &midi NOTE_A_7
   &midi NOTE_C_5   &midi NOTE_Eb_5   &midi NOTE_G_5  &midi NOTE_Bb_5   &midi NOTE_D_6                   &midi NOTE_F_6   &midi NOTE_A_6 &midi NOTE_C_7  &midi NOTE_Eb_7  &midi NOTE_G_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_Eb                                                                         &to MI_F  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_Bb  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_Bb MA_Bb  &none      &midi OCT_DOWN  &none
            >;
