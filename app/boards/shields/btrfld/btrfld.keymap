#define MI7_C  51
#define MI7_G  52
#define MI7_D  53
#define MI7_A  54
#define MI7_E  55
#define MI7_B  56

// Augmented
#define AUG_Ab  57
#define AUG_Eb  58
#define AUG_Bb  59
#define AUG_F  60
#define AUG_C  61
#define AUG_G  62
#define AUG_D  63
#define AUG_A  64
#define AUG_E  65
#define AUG_B  66

// Diminished
#define DIM_Ab  67
#define DIM_Eb  68
#define DIM_Bb  69
#define DIM_F  70
#define DIM_C  71
#define DIM_G  72
#define DIM_D  73
#define DIM_A  74
#define DIM_E  75
#define DIM_B  76


//TODO these function layers come after all others, and so should have their number increased as we fill out the other layers
// they need to be at the end because of how zmk handles layers. higher number layers are processed first
#define CHORD 27
#define MIDI_BASE_1_CHORD 28
#define MIDI_BASE_2_CHORD 29
//TODO use conditional layers for the chord key combos?


/ {
  conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer_midi_base_1 {
            if-layers = <CHORD MIDI_BASE>;
            then-layer = <MIDI_BASE_1_CHORD>;
        };

        tri_layer_midi_base_2 {
            if-layers = <CHORD MIDI_BASE_2>;
            then-layer = <MIDI_BASE_2_CHORD>;
        };

    };

// switch the bt device depending on the number of taps on td0
    behaviors {
        out_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&out OUT_SHO>, <&out OUT_BLE>, <&out OUT_USB>;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_Ab_ma: Ab_major {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_Ab>
            , <&macro_press &midi NOTE_Ab_5>
            , <&macro_press &midi NOTE_C_6>
            , <&macro_press &midi NOTE_Ds_6>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_Ab>
            , <&macro_release &midi NOTE_Ab_5>
            , <&macro_release &midi NOTE_C_6>
            , <&macro_release &midi NOTE_Ds_6>
            ;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_Eb_ma: Eb_major {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_Eb>
            , <&macro_press &midi NOTE_Eb_5>
            , <&macro_press &midi NOTE_G_5>
            , <&macro_press &midi NOTE_As_5>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_Eb>
            , <&macro_release &midi NOTE_Eb_5>
            , <&macro_release &midi NOTE_G_5>
            , <&macro_release &midi NOTE_As_5>
            ;
        };


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ch_Bb_ma: Bb_major {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_Bb>
