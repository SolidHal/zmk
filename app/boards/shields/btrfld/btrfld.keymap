#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/midi.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>



// go to bootloader: &bootloader
// presents key from higher layer: &trans
// no function: &none

#define DEFAULT_L  0
#define NUM_L      1
#define ARROW_L    2
#define GAME_L     3
#define GAME_FN_L  4

#define MIDI_BASE_MA   5
#define MIDI_BASE_MI 6

// Major chords
#define MA_Db  7
#define MA_Ab  8
#define MA_Eb  9
#define MA_Bb  10
#define MA_F  11
#define MA_C  12
#define MA_G  13
#define MA_D  14
#define MA_A  15
#define MA_E  16
#define MA_B  17
#define MA_Gb 18

// Minor Chords

#define MI_Db  19
#define MI_Ab  20
#define MI_Eb  21
#define MI_Bb  22
#define MI_F  23
#define MI_C  24
#define MI_G  25
#define MI_D  26
#define MI_A  27
#define MI_E  28
#define MI_B  29
#define MI_Gb 30

// Major chords again
// we need these because otherwise the minor chords cant
// &mo to major chord layers, as the minor chord layers are "higher" number than the major chord layers
// so we can hack this by &mo -ing to these instead
// TODO this solution won't work, seems we go pase max # of layers and end up at default again
#define MA_Ab_2  27
#define MA_Eb_2  28
#define MA_Bb_2  29
#define MA_F_2  30
#define MA_C_2  31
#define MA_G_2  32
#define MA_D_2  33
#define MA_A_2  34
#define MA_E_2  35
#define MA_B_2  36


// some layers may need to be at the end because of how zmk handles layers. higher number layers are processed first


/ {

// switch the bt device depending on the number of taps on td0
    behaviors {
        out_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&out OUT_SHO>, <&out OUT_BLE>, <&out OUT_USB>;
        };

//TODO this does not work??

/**
 * Temporarily switches to a layer ( like `&mo`) while key is held, but uses
 * `&to` to work around the higher vs lower layer problem
 *
 * Params:
 *  1. Layer to switch to on press
 *  2. layer to switch to on release
 *
 * Example:
 *  `&tmo LAYER2 LAYER1
 */
tmo: tmo {
    compatible = "zmk,behavior-macro-two-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <2>;
    bindings
        = <&macro_param_1to1>
        , <&macro_press &to MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_param_2to1>
        , <&macro_release &to MACRO_PLACEHOLDER>
        ;
};



/**
 * Temporarily switches to a layer (`&mo`) while a modifier is held.
 * Analogous to QMK's `LM()`, using a parameterized macro.
 *
 * Params:
 *  1. Layer to switch to
 *  2. Modifier to press while layer is active
 *
 * Example:
 *  `&lm NUM_LAYER LSHIFT`
 */
lm: lm {
    compatible = "zmk,behavior-macro-two-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <2>;
    bindings
        = <&macro_param_1to1>
        , <&macro_press &mo MACRO_PLACEHOLDER>
        , <&macro_param_2to1>
        , <&macro_press &kp MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_param_2to1>
        , <&macro_release &kp MACRO_PLACEHOLDER>
        , <&macro_param_1to1>
        , <&macro_release &mo MACRO_PLACEHOLDER>
        ;
};

};

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |    Q    |    W    |    E    |    R    |    T    |                                          |    Y    |    U    |    I    |    O    |    P    |
// |    A    |    S    |    D    |    F    |    G    |                                          |    H    |    J    |    K    |    L    |    ;    |
// |    Z    |    X    |    C    |    V    |    B    |                                          |    N    |    M    |    ,    |    .    |    /    |
// |BT/USB td|  VOL_DN | VOL_UP  |                                                                                  |   LALT  |   DEL   |   bt sho  |
//                               |   GUI   |   SPACE | ESC     |                      |backspace| L SHIFT |  ENTER  |
//                                         |NUM_LAYER| l_ctrl  |                      |   TAB   |ARROW_LAYER|

bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
    &out_td &kp C_VOL_DN &kp C_VOL_UP                                                                                   &kp LALT  &kp DEL   &bt BT_SHO
                                  &kp LGUI    &kp SPC   &kp ESC                         &kp BSPC  &kp LSHFT  &kp ENTER
                                              &mo NUM_L &kp LCTRL                       &kp TAB   &mo ARROW_L
            >;
        };

        num_layer {
bindings = <
  &bt BT_SEL 0   &kp GRAVE &kp MINUS &kp EQUAL   &none                                               &none     &kp N7    &kp N8    &kp N9     &none
  &bt BT_SEL 1   &kp LBKT  &kp RBKT   &kp BSLH   &none                                               &kp N0    &kp N4    &kp N5    &kp N6     &none
  &bt BT_SEL 2   &kp SEMI   &kp SQT   &kp FSLH   &none                                               &kp DOT   &kp N1    &kp N2    &kp N3    &none
  &bt BT_SEL 3    &trans    &trans                                                                                      &trans   &trans    &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        arrow_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &to MIDI_BASE_MA                                                 &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
   &bt BT_CLR    &none &none    &none   &none                                                &kp HOME    &none       &none     &kp END    &to GAME_L
      &trans    &trans  &trans                                                                                        &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        game_layer {
bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
      &kp N0     &kp N1   &kp N2                                                                                       &kp N3  &kp N4      &kp N5
                                  &kp LSHFT    &kp SPC   &kp ESC                      &kp BSPC  &kp LSHFT  &kp RALT
                                              &mo LCTRL &kp TAB                       &kp TAB   &mo GAME_FN_L
            >;
        };

        game_function_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &none                                                &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
      &none     &none   &none   &none   &none                                                &none       &none       &none     &none  &to DEFAULT_L
      &trans    &trans  &trans                                                                                       &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };


        midi_base_ma {
bindings = <
   &none     &none   &none  &none     &none                                      &none     &none   &none  &none     &none
   &none     &none   &none  &none     &none                                      &none     &none   &none  &none     &none
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                             &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                             &none  &to MIDI_BASE_MI  &none       &midi OCT_UP  &none &none
                                    &tmo MIDI_BASE_MI MIDI_BASE_MA &none      &midi OCT_DOWN  &midi SUSTAIN
            >;
        };

        midi_base_mi {
bindings = <
   &none     &none   &none  &none     &none                                    &none     &none   &none  &none     &none
   &none     &none   &none  &none     &none                                    &none     &none   &none  &none     &none
   &to MI_Ab  &to MI_Eb  &to MI_Bb &to MI_F &to MI_C                           &to MI_G  &to MI_D  &to MI_A &to MI_E &to MI_B
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                             &none  &none   &to MIDI_BASE_MA       &midi OCT_UP  &none &none
                                    &none   &tmo MIDI_BASE_MA  MIDI_BASE_MI    &midi OCT_DOWN  &midi SUSTAIN
            >;
        };


