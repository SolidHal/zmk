        C_major {
bindings = <
   &midi NOTE_E_4   &midi NOTE_G_4   &midi NOTE_B_4  &midi NOTE_D_5   &midi NOTE_F_5                   &midi NOTE_A_5   &midi NOTE_C_6  &midi NOTE_E_6  &midi NOTE_G_6  &midi NOTE_B_6
   &midi NOTE_D_4   &midi NOTE_F_4   &midi NOTE_A_4  &midi NOTE_C_5   &midi NOTE_E_5                   &midi NOTE_G_5   &midi NOTE_B_5 &midi NOTE_D_6  &midi NOTE_F_6  &midi NOTE_A_6
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_F                                                                         &to MI_G  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_C  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_C MA_C  &none      &midi OCT_DOWN  &none
            >;
