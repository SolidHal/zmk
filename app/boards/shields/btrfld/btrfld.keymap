   &midi NOTE_Fs_4   &midi NOTE_A_4   &midi NOTE_Cs_5  &midi NOTE_E_5   &midi NOTE_Gs_5                   &midi NOTE_B_5   &midi NOTE_Ds_6 &midi NOTE_Fs_6  &midi NOTE_A_6  &midi NOTE_Cs_7
   &to MA_Ab  &to MA_Eb  &to MA_Bb &to MA_F &to MA_C                                                   &to MA_G  &to MA_D  &to MA_A &to MA_E &to MA_B
   &to MA_Db   &none  &to MI_A                                                                         &to MI_B  &none     &to MA_Gb
                &midi SUSTAIN  &to MI_E  &none                        &midi OCT_UP  &none  &midi SUSTAIN
                              &tmo MI_E MA_E  &none      &midi OCT_DOWN  &none
            >;
