        D_minor {
bindings = <
   &mo MA_G  &mo MA_D  &mo MA_A &mo MA_E &mo MA_B                           &midi NOTE_C_5   &midi NOTE_E_5   &midi NOTE_G_5  &midi NOTE_As_5     &midi NOTE_D_6
   &mo MI_G  &mo MI_D  &mo MI_A &mo MI_E &mo MI_B                           &midi NOTE_As_4   &midi NOTE_D_5   &midi NOTE_F_5  &midi NOTE_A_5     &midi NOTE_C_6
   &trans  &trans  &trans  &trans  &trans                                      &midi NOTE_As_3   &midi NOTE_D_4   &midi NOTE_F_4  &midi NOTE_A_4     &midi NOTE_C_5
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };


        A_minor {
bindings = <
   &mo MA_G  &mo MA_D  &mo MA_A &mo MA_E &mo MA_B                           &midi NOTE_G_5   &midi NOTE_B_5   &midi NOTE_D_6  &midi NOTE_F_6     &midi NOTE_A_6
   &mo MI_G  &mo MI_D  &mo MI_A &mo MI_E &mo MI_B                           &midi NOTE_F_5   &midi NOTE_A_5   &midi NOTE_C_6  &midi NOTE_E_6     &midi NOTE_G_6
   &trans  &trans  &trans  &trans  &trans                                      &midi NOTE_F_4   &midi NOTE_A_4   &midi NOTE_C_5  &midi NOTE_E_5     &midi NOTE_G_5
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };


        E_minor {
bindings = <
   &mo MA_G  &mo MA_D  &mo MA_A &mo MA_E &mo MA_B                           &midi NOTE_D_5   &midi NOTE_Fs_5   &midi NOTE_A_5  &midi NOTE_C_6     &midi NOTE_E_6
   &mo MI_G  &mo MI_D  &mo MI_A &mo MI_E &mo MI_B                           &midi NOTE_C_5   &midi NOTE_E_5   &midi NOTE_G_5  &midi NOTE_B_5     &midi NOTE_D_6
   &trans  &trans  &trans  &trans  &trans                                      &midi NOTE_C_4   &midi NOTE_E_4   &midi NOTE_G_4  &midi NOTE_B_4     &midi NOTE_D_5
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };


        B_minor {
bindings = <
   &mo MA_G  &mo MA_D  &mo MA_A &mo MA_E &mo MA_B                           &midi NOTE_A_5   &midi NOTE_Cs_6   &midi NOTE_E_6  &midi NOTE_G_6     &midi NOTE_B_6
   &mo MI_G  &mo MI_D  &mo MI_A &mo MI_E &mo MI_B                           &midi NOTE_G_5   &midi NOTE_B_5   &midi NOTE_D_6  &midi NOTE_Fs_6     &midi NOTE_A_6
   &trans  &trans  &trans  &trans  &trans                                      &midi NOTE_G_4   &midi NOTE_B_4   &midi NOTE_D_5  &midi NOTE_Fs_5     &midi NOTE_A_5
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };

// ############################################
// **** PLACE SCALE LAYERS ABOVE HERE *********
// ############################################
// TODO having the chord layers be &to instead of &mo is nice for playing, but need to debug them more

// not explicitly used, but its activation is a variable to determine whether chords should make sound when pressed
        chord_indicator {
bindings = <
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans                                                                          &trans  &trans     &trans
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };

        midi_base_1_chord_on {
bindings = <
   &ch_Ab_ma   &ch_Eb_ma  &ch_Bb_ma    &ch_F_ma &ch_C_ma                                           &trans     &trans   &trans  &trans     &trans
   &ch_Ab_mi   &ch_Eb_mi  &ch_Bb_mi    &ch_F_mi &ch_C_mi                                           &trans     &trans   &trans  &trans     &trans
 &ch_Ab_sev  &ch_Eb_sev  &ch_Bb_sev    &ch_F_sev &ch_C_sev                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans                                                                          &trans  &trans     &trans
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };


        midi_base_2_chord_on {
bindings = <
   &ch_G_ma   &ch_D_ma  &ch_A_ma    &ch_E_ma &ch_B_ma                                           &trans     &trans   &trans  &trans     &trans
   &ch_G_mi   &ch_D_mi  &ch_A_mi    &ch_E_mi &ch_B_mi                                           &trans     &trans   &trans  &trans     &trans
 &ch_G_sev  &ch_D_sev  &ch_A_sev    &ch_E_sev &ch_B_sev                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans                                                                          &trans  &trans     &trans
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };

    };
};


// each major scale has a root note and then goes
// 2 2 1 2 2 2 1
// each minor scale
// 2 1 2 2 1 2 2