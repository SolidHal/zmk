#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/midi.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>



// go to bootloader: &bootloader
// presents key from higher layer: &trans
// no function: &none

#define DEFAULT_L  0
#define NUM_L      1
#define ARROW_L    2
#define GAME_L     3
#define GAME_FN_L  4

#define MIDI_BASE   5
#define MIDI_BASE_2 6

// Major chords
#define MA_Eb  7
#define MA_Bb  8
#define MA_F  9
#define MA_C  10
#define MA_G  11
#define MA_D  12
#define MA_A  13
#define MA_E  14
#define MA_B  15
#define MA_Fs  16

// Minor Chords
#define MI_Eb  17
#define MI_Bb  18
#define MI_F  19
#define MI_C  20
#define MI_G  21
#define MI_D  22
#define MI_A  23
#define MI_E  24
#define MI_B  25
#define MI_Fs  26

// 7ths 
#define SEV_Eb  27
#define SEV_Bb  28
#define SEV_F  29
#define SEV_C  30
#define SEV_G  31
#define SEV_D  32
#define SEV_A  33
#define SEV_E  34
#define SEV_B  35
#define SEV_Fs  36

// Major 7ths
#define MA7_Eb  37
#define MA7_Bb  38
#define MA7_F  39
#define MA7_C  40
#define MA7_G  41
#define MA7_D  42
#define MA7_A  43
#define MA7_E  44
#define MA7_B  45
#define MA7_Fs  46

// Minor 7ths
#define MI7_Eb  47
#define MI7_Bb  48
#define MI7_F  49
#define MI7_C  50
#define MI7_G  51
#define MI7_D  52
#define MI7_A  53
#define MI7_E  54
#define MI7_B  55
#define MI7_Fs  56

// Augmented
#define AUG_Eb  57
#define AUG_Bb  58
#define AUG_F  59
#define AUG_C  60
#define AUG_G  61
#define AUG_D  62
#define AUG_A  63
#define AUG_E  64
#define AUG_B  65
#define AUG_Fs  66

// Diminished
#define DIM_Eb  67
#define DIM_Bb  68
#define DIM_F  69
#define DIM_C  70
#define DIM_G  71
#define DIM_D  72
#define DIM_A  73
#define DIM_E  74
#define DIM_B  75
#define DIM_Fs  76


//TODO these function layers come after all others, and so should have their number increased as we fill out the other layers
// they need to be at the end because of how zmk handles layers. higher number layers are processed first
#define CHORD 10
#define MIDI_BASE_1_CHORD 11
#define MIDI_BASE_2_CHORD 12
//TODO use conditional layers for the chord key combos?


/ {
  conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer_midi_base_1 {
            if-layers = <CHORD MIDI_BASE>;
            then-layer = <MIDI_BASE_1_CHORD>;
        };

        tri_layer_midi_base_2 {
            if-layers = <CHORD MIDI_BASE>;
            then-layer = <MIDI_BASE_2_CHORD>;
        };

    };

// switch the bt device depending on the number of taps on td0
    behaviors {
        out_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&out OUT_SHO>, <&out OUT_BLE>, <&out OUT_USB>;
        };


//TODO problem, wait-ms is not respected on release so often the release steps get eaten before making it to the host as they all send at the same time


// macros for each chord key, so we can switch to the chords layer and press the chords keys at the same time
        ma_Eb: major_Eb {
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
            = <&macro_press &mo MA_Eb>
            , <&macro_press &midi NOTE_Eb_4>
            , <&macro_press &midi NOTE_G_4>
            , <&macro_press &midi NOTE_Bb_4>
            , <&macro_pause_for_release>
            , <&macro_release &mo MA_Eb>
            , <&macro_release &midi NOTE_Eb_4>
            , <&macro_release &midi NOTE_G_4>
            , <&macro_release &midi NOTE_Bb_4>
            ;
        };

// we want to be able to toggle on/off chords playing when chord keys are pressed
// can we set a global variable to do this?
// 

/**
 * Temporarily switches to a layer (`&mo`) while a modifier is held.
 * Analogous to QMK's `LM()`, using a parameterized macro.
 *
 * Params:
 *  1. Layer to switch to
 *  2. Modifier to press while layer is active
 *
 * Example:
 *  `&lm NUM_LAYER LSHIFT`
 */
lm: lm {
    compatible = "zmk,behavior-macro-two-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <2>;
    bindings
        = <&macro_param_1to1>
        , <&macro_press &mo MACRO_PLACEHOLDER>
        , <&macro_param_2to1>
        , <&macro_press &kp MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_param_2to1>
        , <&macro_release &kp MACRO_PLACEHOLDER>
        , <&macro_param_1to1>
        , <&macro_release &mo MACRO_PLACEHOLDER>
        ;
};
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |    Q    |    W    |    E    |    R    |    T    |                                          |    Y    |    U    |    I    |    O    |    P    |
// |    A    |    S    |    D    |    F    |    G    |                                          |    H    |    J    |    K    |    L    |    ;    |
// |    Z    |    X    |    C    |    V    |    B    |                                          |    N    |    M    |    ,    |    .    |    /    |
// |BT/USB td|  VOL_DN | VOL_UP  |                                                                                  |   LALT  |   DEL   |   bt sho  |
//                               |   GUI   |   SPACE | ESC     |                      |backspace| L SHIFT |  ENTER  |
//                                         |NUM_LAYER| l_ctrl  |                      |   TAB   |ARROW_LAYER|

bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
    &out_td &kp C_VOL_DN &kp C_VOL_UP                                                                                   &kp LALT  &kp DEL   &bt BT_SHO
                                  &kp LGUI    &kp SPC   &kp ESC                         &kp BSPC  &kp LSHFT  &kp ENTER
                                              &mo NUM_L &kp LCTRL                       &kp TAB   &mo ARROW_L
            >;
        };

        num_layer {
bindings = <
  &bt BT_SEL 0   &kp GRAVE &kp MINUS &kp EQUAL   &none                                               &none     &kp N7    &kp N8    &kp N9     &none
  &bt BT_SEL 1   &kp LBKT  &kp RBKT   &kp BSLH   &none                                               &kp N0    &kp N4    &kp N5    &kp N6     &none
  &bt BT_SEL 2   &kp SEMI   &kp SQT   &kp FSLH   &none                                               &kp DOT   &kp N1    &kp N2    &kp N3    &none
  &bt BT_SEL 3    &trans    &trans                                                                                      &trans   &trans    &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        arrow_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &to MIDI_BASE                                                 &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
   &bt BT_CLR    &none &none    &none   &none                                                &kp HOME    &none       &none     &kp END    &to GAME_L
      &trans    &trans  &trans                                                                                        &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };

        game_layer {
bindings = <
      &kp Q     &kp W     &kp E     &kp R      &kp T                                               &kp Y     &kp U     &kp I     &kp O     &kp P   
      &kp A     &kp S     &kp D     &kp F      &kp G                                               &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp Z     &kp X     &kp C     &kp V      &kp B                                               &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
      &kp N0     &kp N1   &kp N2                                                                                       &kp N3  &kp N4      &kp N5
                                  &kp LSHFT    &kp SPC   &kp ESC                      &kp BSPC  &kp LSHFT  &kp RALT
                                              &mo LCTRL &kp TAB                       &kp TAB   &mo GAME_FN_L
            >;
        };

        game_function_layer {
bindings = <
      &kp F1   &kp F2  &kp F3   &kp F4   &kp F5                                               &kp F6     &kp F7      &kp F8    &kp F9     &kp F10
    &bootloader  &none  &none   &none   &none                                                &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp F11
      &none     &none   &none   &none   &none                                                &none       &none       &none     &none  &to DEFAULT_L
      &trans    &trans  &trans                                                                                       &trans     &trans       &trans
                                   &trans    &trans   &trans                        &trans   &trans  &trans
                                             &trans   &trans                        &trans   &trans
            >;
        };


        midi_base {
bindings = <
   &mo MA_Eb   &mo MA_Bb  &mo MA_F &mo MA_C &mo MA_G                                           &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &none  &none &none     &none  &none &none
                                                    &mo CHORD &tog CHORD     &none  &midi SUSTAIN
            >;
        };

        midi_base_2 {
bindings = <
   &mo MA_D   &mo MA_A  &mo MA_E &mo MA_B &mo MA_Fs                                           &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &none   &none  &none    &none &none                                           &none     &none   &none  &none     &none
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &none  &none &none     &none  &none &none
                                                    &mo CHORD &tog CHORD     &none  &midi SUSTAIN
            >;
        };


        major_Eb {
bindings = <
   &trans  &trans &trans   &trans &trans                                              &none     &midi NOTE_F_4   &midi NOTE_Ab_4  &midi NOTE_C_5     &midi NOTE_Eb_5
   &trans   &trans  &trans  &trans &trans                                              &none     &midi NOTE_Eb_4   &midi NOTE_G_4   &midi NOTE_Bb_4     &midi NOTE_D_5
   &trans   &trans  &trans  &trans &trans                                              &none     &midi NOTE_Eb_3   &midi NOTE_G_3  &midi NOTE_Bb_3     &midi NOTE_D_4
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &none  &none &none     &none  &none &none
                                                    &none &none     &none  &midi SUSTAIN
            >;
        };

        major_Bb {
bindings = <
   &trans   &trans  &trans &trans &trans                                               &none     &midi NOTE_C_5   &midi NOTE_Eb_5  &midi NOTE_G_5     &midi NOTE_Bb_5
   &none   &none  &none    &none &none                                              &none     &midi NOTE_Bb_4   &midi NOTE_D_5   &midi NOTE_F_5     &midi NOTE_A_5
   &none   &none  &none    &none &none                                              &none     &midi NOTE_Bb_3   &midi NOTE_D_4   &midi NOTE_F_4     &midi NOTE_A_4
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &none  &none &none     &none  &none &none
                                                    &none &none     &none  &midi SUSTAIN
            >;
        };

        major_F {
bindings = <
   &mo MA_Eb   &mo MA_Bb  &none &mo MA_C &mo MA_G                                               &none     &midi NOTE_G_4   &midi NOTE_Bb_4  &midi NOTE_D_5     &midi NOTE_F_5
   &none   &none  &none    &none &none                                              &none     &midi NOTE_F_4   &midi NOTE_A_4   &midi NOTE_C_5     &midi NOTE_E_5
   &none   &none  &none    &none &none                                              &none     &midi NOTE_F_3   &midi NOTE_A_3   &midi NOTE_C_4     &midi NOTE_E_4
   &to DEFAULT_L   &none  &none                                                                          &none  &none     &none
                                             &none  &none &none     &none  &none &none
                                                    &none &none     &none  &midi SUSTAIN
            >;
        };

// not explicitly used, but its activation is a variable to determine whether chords should make sound when pressed
        chord_indicator {
bindings = <
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans                                                                          &trans  &trans     &trans
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };

        midi_base_1_chord_on {
bindings = <
   &ma_Eb   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans    &trans &trans                                           &trans     &trans   &trans  &trans     &trans
   &trans   &trans  &trans                                                                          &trans  &trans     &trans
                                             &trans  &trans &trans     &trans  &trans &trans
                                                    &trans &trans     &trans  &trans
            >;
        };

    };
};
